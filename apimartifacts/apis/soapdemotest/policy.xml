<!--
    - Policies are applied in the order they appear.
    - Position <base/> inside a section to inherit policies from the outer scope.
    - Comments within policies are not preserved.
-->
<!-- Add policies as children to the <inbound>, <outbound>, <backend>, and <on-error> elements -->
<policies>
	<!-- Throttle, authorize, validate, cache, or transform the requests -->
	<inbound>
		<base />
		<!--<trace source="SOAP-DEBUG" severity="information">
            <message>@(context.Request.Body.As<string>())</message>
        </trace>-->
		<set-body>@{
        var body = context.Request.Body.As<string>(preserveContent: true);
        var header = @"<Header>
        <wsse:Security xmlns:wsse=""http://schemas.xmlsoap.org/ws/2002/12/secext"">
        <wsse:UsernameToken>
        <wsse:Username>dummyUser</wsse:Username>
        <wsse:Password>dummyPass</wsse:Password>
        </wsse:UsernameToken>
        </wsse:Security>
        </Header>";
        if (body.Contains("<Body>"))
        {
        body = body.Replace("<Body>", header + "<Body>");
        }
        return body;
        }</set-body>
		<!--<trace source="SOAP-DEBUG" severity="information">
            <message>@(context.Request.Body.As<string>())</message>
        </trace>-->
	</inbound>
	<!-- Control if and how the requests are forwarded to services  -->
	<backend>
		<base />
	</backend>
	<!-- Customize the responses -->
	<outbound>
		<base />
		<return-response>
			<set-status code="200" reason="OK" />
			<!-- Return the modified SOAP -->
			<set-body>
        @(context.Request.Body.As<string>())
      </set-body>
		</return-response>
	</outbound>
	<!-- Handle exceptions and customize error responses  -->
	<on-error>
		<base />
	</on-error>
</policies>